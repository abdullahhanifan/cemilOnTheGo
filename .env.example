APP_NAME="ALH Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite is the quick-start default (see README). For MySQL/PostgreSQL set DB_CONNECTION and uncomment the rest.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=alh_core
# DB_USERNAME=root
# DB_PASSWORD=

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# "log" writes mail (e.g. password reset links) to storage/logs during development.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- ALH Core ---
# Public /signup is disabled unless this is true.
ALH_REGISTRATION_ENABLED=false
# Needs the PHP "gd" extension. Set true to turn the captcha off.
CAPTCHA_DISABLE=false
# Comma-separated proxy IPs/CIDRs to trust. Empty trusts none.
TRUSTED_PROXIES=

# Initial admin account created by `php artisan migrate --seed`.
# In production the seeder refuses an empty, placeholder, or short (< 12 chars) password.
ADMIN_NAME="Administrator"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=GANTI-SEBELUM-DIPAKAI
