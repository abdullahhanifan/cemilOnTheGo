APP_NAME="cemilOnTheGo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL is the default. Create the database, then fill in your own credentials in .env (never in this file).
# For a quick start without MySQL: DB_CONNECTION=sqlite and `touch database/database.sqlite`.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cemilonthego
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# "log" writes mail (e.g. password reset links) to storage/logs during development.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- cemilOnTheGo ---
# Public /signup is disabled unless this is true.
ALH_REGISTRATION_ENABLED=false
# Needs the PHP "gd" extension. Set true to turn the captcha off.
CAPTCHA_DISABLE=false
# Comma-separated proxy IPs/CIDRs to trust. Empty trusts none.
TRUSTED_PROXIES=

# Initial admin account created by `php artisan migrate --seed`.
# In production the seeder refuses an empty, placeholder, or short (< 12 chars) password.
ADMIN_NAME="Administrator"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=GANTI-SEBELUM-DIPAKAI
